# =====================================================
# ProspectAI — Root .gitignore
# =====================================================

# Environment files
.env
*.env.local
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Build outputs
/build/
/dist/
/out/

# Uploaded documents (user data — never commit)
/uploads/
